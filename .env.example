# ── SmartCommerce Pro — Environment Variables ─────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── Database (PostgreSQL) ─────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/smartcommerce
DB_USER=scuser
DB_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────
# Must be at least 256 bits (32 characters) — generate with:
#   openssl rand -base64 64
JWT_SECRET=replace-with-a-real-256bit-secret-generated-by-openssl-rand-base64-64

JWT_ACCESS_EXPIRY_MS=900000       # 15 minutes
JWT_REFRESH_EXPIRY_MS=604800000   # 7 days

# ── Email (SMTP) ──────────────────────────────────────────────────
# Dev: use Mailhog (already configured in docker-compose)
# Prod: use Gmail / SendGrid / SES
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Google OAuth2 ─────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── GitHub OAuth2 (optional) ─────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth2 Frontend Callback ──────────────────────────────────────
# URL where tokens are forwarded after successful OAuth2 login
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── OTP ───────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ── Docker tooling ───────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password
PGADMIN_PASSWORD=admin
